<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2025 Guard Hero. All rights reserved.
  Use of this source code is governed by a BSD-style license.

  guardhero_strings.grd — Guard Hero product name and description strings.
  These are included by chrome_strings.grd via <part> or merged via the
  Guard Hero branding patch (patches/core/001-branding-product-name.patch).

  To add a new string:
    1. Add a <message> element with a unique IDS_ name.
    2. If the string needs translation, set translateable="true" (default).
    3. For UI strings with placeholders, use <ph name="..."> elements.
-->
<grit latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/guardhero_strings.h" type="rc_header">
      <emit emit_type="prepend"></emit>
    </output>
    <output filename="guardhero_strings_en-US.pak" type="data_package"
            lang="en" />
  </outputs>

  <translations />

  <release seq="1" allow_pseudo="false">
    <messages fallback_to_english="true">

      <!-- ── Product identification ─────────────────────────────────────── -->

      <message name="IDS_PRODUCT_NAME"
               desc="The full name of this browser product.">
        Guard Hero Browser
      </message>

      <message name="IDS_SHORT_PRODUCT_NAME"
               desc="Short name of the product used in space-constrained UI.">
        Guard Hero
      </message>

      <message name="IDS_APP_SHORTCUT_NAME"
               desc="Name shown in OS app launchers, taskbars, and dock.">
        Guard Hero Browser
      </message>

      <message name="IDS_PRODUCT_DESCRIPTION"
               desc="One-line marketing description shown in about dialogs and stores.">
        A privacy-first browser that fights back.
      </message>

      <!-- ── About dialog strings ────────────────────────────────────────── -->

      <message name="IDS_ABOUT_VERSION_COMPANY_NAME"
               desc="Company name shown in the About dialog version string.">
        Guard Hero
      </message>

      <message name="IDS_ABOUT_PRODUCT_NAME"
               desc="Product name shown in the About dialog title.">
        Guard Hero Browser
      </message>

      <message name="IDS_ABOUT_PRODUCT_TAGLINE"
               desc="Tagline shown on the About page.">
        The browser that fights back.
      </message>

      <message name="IDS_ABOUT_VERSION_COPYRIGHT"
               desc="Copyright notice in the About dialog.">
        Copyright 2025 Guard Hero. All rights reserved.
      </message>

      <!-- ── Window / OS integration strings ────────────────────────────── -->

      <message name="IDS_BROWSER_WINDOW_TITLE_FORMAT"
               desc="Format string for the browser window title. {0} = page title.">
        <ph name="PAGE_TITLE">$1<ex>Example Site</ex></ph> - Guard Hero Browser
      </message>

      <message name="IDS_NEW_TAB_TITLE"
               desc="Title of the new tab page.">
        New Tab
      </message>

      <message name="IDS_TASK_MANAGER_BROWSER_PROCESS_TITLE"
               desc="Name of the browser process shown in the task manager.">
        Guard Hero Browser
      </message>

      <!-- ── First-run / onboarding ──────────────────────────────────────── -->

      <message name="IDS_FIRST_RUN_SENTINEL_FILE_NAME"
               translateable="false"
               desc="Name of the sentinel file written after first run.">
        First Run
      </message>

      <message name="IDS_FIRST_RUN_TITLE"
               desc="Title of the first-run welcome dialog.">
        Welcome to Guard Hero Browser
      </message>

      <message name="IDS_FIRST_RUN_BODY"
               desc="Body text of the first-run welcome dialog.">
        Guard Hero Browser has blocked 0 trackers so far. Give us a moment to load
        your blocklist and you'll be protected immediately.
      </message>

      <!-- ── EagleEye / blocking UI ──────────────────────────────────────── -->

      <message name="IDS_EAGLEEYE_TOOLBAR_BUTTON_TOOLTIP"
               desc="Tooltip for the EagleEye shield button in the toolbar.">
        Guard Hero — EagleEye Blocker
      </message>

      <message name="IDS_EAGLEEYE_BLOCKED_COUNT_SINGULAR"
               desc="Message when exactly 1 tracker has been blocked on the current page.">
        1 tracker blocked on this page
      </message>

      <message name="IDS_EAGLEEYE_BLOCKED_COUNT_PLURAL"
               desc="Message when multiple trackers have been blocked. {0} = count.">
        <ph name="COUNT">$1<ex>42</ex></ph> trackers blocked on this page
      </message>

      <message name="IDS_EAGLEEYE_PROTECTION_ON"
               desc="Status text when EagleEye protection is enabled.">
        Protection enabled
      </message>

      <message name="IDS_EAGLEEYE_PROTECTION_OFF"
               desc="Status text when EagleEye protection is disabled for the site.">
        Protection paused for this site
      </message>

      <message name="IDS_EAGLEEYE_ALLOW_SITE_BUTTON"
               desc="Button label to allow (whitelist) the current site.">
        Allow this site
      </message>

      <message name="IDS_EAGLEEYE_BLOCK_SITE_BUTTON"
               desc="Button label to re-enable blocking on a previously allowed site.">
        Resume blocking
      </message>

      <!-- ── Settings strings ────────────────────────────────────────────── -->

      <message name="IDS_SETTINGS_PAGE_TITLE"
               desc="Title of the Guard Hero settings page.">
        Guard Hero Settings
      </message>

      <message name="IDS_SETTINGS_PRIVACY_SECTION_TITLE"
               desc="Section header for privacy settings.">
        Privacy &amp; Security
      </message>

      <message name="IDS_SETTINGS_EAGLEEYE_SECTION_TITLE"
               desc="Section header for EagleEye settings.">
        EagleEye Blocker
      </message>

      <message name="IDS_SETTINGS_APPEARANCE_SECTION_TITLE"
               desc="Section header for appearance settings.">
        Appearance
      </message>

      <!-- ── Update strings ─────────────────────────────────────────────── -->

      <message name="IDS_UPDATE_AVAILABLE_TITLE"
               desc="Title of the update available notification.">
        Guard Hero Browser update available
      </message>

      <message name="IDS_UPDATE_AVAILABLE_BODY"
               desc="Body of the update available notification.">
        A new version of Guard Hero Browser is available. Restart to update.
      </message>

      <message name="IDS_UPDATE_RELAUNCH_BUTTON"
               desc="Button to relaunch the browser and apply the update.">
        Relaunch to update
      </message>

    </messages>
  </release>
</grit>
