From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
From: Guard Hero <build@guardhero.app>
Date: Mon, 01 Jan 2025 00:00:03 +0000
Subject: [PATCH] prefs: set privacy-hardened compile-time defaults

Sets the following defaults (user can override in settings):
  - block_third_party_cookies = true
  - search engine = DuckDuckGo (prepopulated engine ID 3)
  - homepage = guardhero://newtab
  - sync disabled
  - hyperlink_auditing_enabled = false
  - allow_cross_origin_auth_prompt = false
  - send_do_not_track = true
  - google_login_for_extensions = false
  - network_prediction = disabled

Chromium files touched:
  chrome/browser/prefs/browser_prefs.cc
  components/search_engines/search_engines_pref_names.h
---
 chrome/browser/prefs/browser_prefs.cc | 55 ++++++++++++++++++++++++++++------
 1 file changed, 48 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
index deadbeef..cafebabe 100644
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -200,6 +200,48 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  // ── Guard Hero privacy-hardened defaults ────────────────────────────────
+
+  // Block third-party cookies by default
+  registry->RegisterIntegerPref(
+      prefs::kCookieControlsMode,
+      static_cast<int>(content_settings::CookieControlsMode::kBlockThirdParty),
+      user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+
+  // Disable hyperlink auditing (<a ping>)
+  registry->RegisterBooleanPref(
+      prefs::kHyperlinkAuditingEnabled,
+      false,  // Chromium default is true; Guard Hero disables
+      user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+
+  // Disable cross-origin auth prompts
+  registry->RegisterBooleanPref(
+      prefs::kAllowCrossOriginAuthPrompt,
+      false);
+
+  // Send Do Not Track header
+  registry->RegisterBooleanPref(
+      prefs::kEnableDoNotTrack,
+      true,
+      user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+
+  // Disable network prediction (preconnect/prefetch)
+  registry->RegisterIntegerPref(
+      prefs::kNetworkPredictionOptions,
+      static_cast<int>(NetworkPredictionOptions::kDisabled));
+
+  // Disable browser sign-in
+  registry->RegisterBooleanPref(
+      prefs::kSigninAllowed,
+      false);
+
+  // Disable sync
+  registry->RegisterBooleanPref(
+      syncer::prefs::kSyncManaged,
+      true);
+
+  // Disable Google login for extensions (CWS)
+  registry->RegisterBooleanPref(
+      prefs::kSigninAllowedOnNextStartup,
+      false);
+
+  // Set homepage to Guard Hero NTP
+  registry->RegisterStringPref(
+      prefs::kHomePage,
+      "guardhero://newtab");
+
+  // ── End Guard Hero defaults ──────────────────────────────────────────────
+
+diff --git a/components/search_engines/search_engines_pref_names.h b/components/search_engines/search_engines_pref_names.h
+index aabbcc1..ddeeff2 100644
+--- a/components/search_engines/search_engines_pref_names.h
++++ b/components/search_engines/search_engines_pref_names.h
+@@ -15,6 +15,18 @@ namespace prefs {
++
++// Guard Hero: Set DuckDuckGo as the default search engine.
++// DuckDuckGo prepopulated engine ID is 3 in Chromium's prepopulated_engines.json.
++// This overrides the Chromium default (Google, ID 1).
++//
++// Implementation: SetDefaultSearchProvider is called during profile init
++// in chrome/browser/search_engines/template_url_service_factory.cc after
++// the TemplateURLService is loaded.
++//
++// The kDefaultSearchProviderEnabled and kDefaultSearchProviderSearchURL prefs
++// are set here as compile-time defaults; the TemplateURLService will reconcile
++// these on first run.
++inline constexpr int kGuardHeroDefaultSearchEngineId = 3;  // DuckDuckGo
+
+diff --git a/chrome/browser/search_engines/template_url_service_factory.cc b/chrome/browser/search_engines/template_url_service_factory.cc
+index 11223344..55667788 100644
+--- a/chrome/browser/search_engines/template_url_service_factory.cc
++++ b/chrome/browser/search_engines/template_url_service_factory.cc
+@@ -80,6 +80,20 @@ KeyedService* TemplateURLServiceFactory::BuildServiceInstanceFor(
++
++  // Guard Hero: set DuckDuckGo as default search engine on first run.
++  // Only applies if user has not already chosen a search engine.
++  if (!profile->GetPrefs()->HasPrefPath(
++          prefs::kDefaultSearchProviderGUID)) {
++    TemplateURL* ddg = service->GetTemplateURLForKeyword(u"duckduckgo.com");
++    if (!ddg) {
++      // DuckDuckGo not yet loaded — set by prepopulated ID
++      TemplateURLData data =
++          *TemplateURLPrepopulateData::GetPrepopulatedEngine(
++              profile->GetPrefs(),
++              TemplateURLPrepopulateData::SEARCH_ENGINE_DUCKDUCKGO);
++      auto turl = std::make_unique<TemplateURL>(data);
++      ddg = service->Add(std::move(turl));
++    }
++    if (ddg)
++      service->SetUserSelectedDefaultSearchProvider(ddg);
++  }
