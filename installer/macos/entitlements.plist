<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow execution of JIT-compiled code (required for V8/JavaScript) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (Chromium renderer requirement) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow DYLD environment variables (for sandboxing) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Disable library validation (required for Chromium's sandbox) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access (for downloads, profile data) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Camera (for WebRTC) -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- Microphone (for WebRTC) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
